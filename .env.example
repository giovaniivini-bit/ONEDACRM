# Hash scrypt da senha administrativa (a senha em texto puro nunca fica no arquivo).
CRM_ADMIN_PASSWORD_HASH=scrypt$sal-em-base64url$hash-em-base64url

# Recuperação temporária para automações antigas. Remova após validar o novo login.
CRM_ADMIN_TOKEN=troque-por-uma-chave-de-recuperacao-forte

# URL pública exata e proxy HTTPS confiável (produção atrás do Caddy/Nginx).
CRM_PUBLIC_ORIGIN=https://crm.136-248-111-213.sslip.io
CRM_TRUST_PROXY=1
CRM_TRUSTED_PROXY_IPS=127.0.0.1,::1

# Tempo de reutilização dos snapshots externos (milissegundos).
EXTERNAL_CACHE_TTL_MS=300000

# Porta local opcional.
PORT=3000
